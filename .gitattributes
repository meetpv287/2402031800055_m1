# Auto detect text files and normalize line endings to LF
* text=auto

# HTML files
*.html text eol=lf

# JavaScript files
*.js text eol=lf

# CSS files
*.css text eol=lf

# Other common files
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
